{
    "id": "org.kde.krename",
    "branch": "master",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "krename",
    "tags": [
        "nightly"
    ],
    "desktop-file-name-suffix": " (Nightly)",
    "finish-args": [
        "--filesystem=host",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "modules": [
        {
            "name": "libexif",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libexif/libexif/releases/download/v0.6.26/libexif-0.6.26.tar.bz2",
                    "sha256": "0830ed253fceeb60444fb309598bc8a9491d3007dc054aad3a50a347c5597c57",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1607,
                        "stable-only": true,
                        "url-template": "https://github.com/libexif/libexif/releases/download/v$version/libexif-$version.tar.bz2"
                    }
                }
            ]
        },
        {
            "name": "taglib",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=ON"
            ],
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://taglib.github.io/releases/taglib-2.3.2.tar.gz",
                    "sha256": "3ca2d8afaa7f1cf7f6ed10e511ebc368bfacd6dcaa3dbfa690b89e502e8963dc",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1982,
                        "stable-only": true,
                        "url-template": "https://taglib.github.io/releases/taglib-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "krename",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
